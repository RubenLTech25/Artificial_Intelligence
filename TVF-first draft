from itertools import combinations

def find_subset(data, target):
    for i in range(1, len(data) + 1):
        for subset in combinations(data, i):
            if sum(subset) == target:
                return subset
    return None

def main():
    data = [1, 2, 3, 4, 5, 6]  # Example data, replace with imported data
    target = 10  # Example target, replace with user input

    result = find_subset(data, target)
    if result:
        print(f"Subset found: {result}")
    else:
        print("Target value not found")

if __name__ == "__main__":
    main()

