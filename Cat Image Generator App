#My code to randomly generate a cat picture from the internet or using DALL-E


import requests
import webbrowser

def get_random_cat_picture():
    try:
        # API endpoint for random cat images
        url = "https://api.thecatapi.com/v1/images/search"
        response = requests.get(url)
        data = response.json()
        cat_url = data[0]["url"]
        return cat_url
    except Exception as e:
        print(f"Error fetching cat picture: {e}")
        return None

def display_cat_picture(cat_url):
    if cat_url:
        webbrowser.open(cat_url)
    else:
        print("Oops! Something went wrong. Couldn't fetch a cat picture.")

if __name__ == "__main__":
    cat_url = get_random_cat_picture()
    display_cat_picture(cat_url)
